{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "/home/snaywart/.config/fastfetch/logo.txt",
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "type": "custom",
            "key": "{#38;2;175;125;155}\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e{#}"
        },
        {
            "type": "title",
            "key": "{#38;2;175;125;155}\u2502{#} {#38;2;244;167;185}\udb80\udd1b user     {#38;2;175;125;155}\u2502{#}",
            "format": "{user-name}"
        },
        {
            "type": "title",
            "key": "{#38;2;175;125;155}\u2502{#} {#38;2;248;190;160}\udb80\uddc5 host     {#38;2;175;125;155}\u2502{#}",
            "format": "{host-name}"
        },
        {
            "type": "os",
            "key": "{#38;2;175;125;155}\u2502{#} {#38;2;150;215;195}\udb82\udcc7 distro   {#38;2;175;125;155}\u2502{#}",
            "format": "{3}"
        },
        {
            "type": "kernel",
            "key": "{#38;2;175;125;155}\u2502{#} {#38;2;200;170;235}\uf013 kernel   {#38;2;175;125;155}\u2502{#}",
            "format": "{2}"
        },
        {
            "type": "wm",
            "key": "{#38;2;175;125;155}\u2502{#} {#38;2;150;185;235}\udb84\udcac desktop  {#38;2;175;125;155}\u2502{#}"
        },
        {
            "type": "terminal",
            "key": "{#38;2;175;125;155}\u2502{#} {#38;2;244;167;185}\ue795 term     {#38;2;175;125;155}\u2502{#}"
        },
        {
            "type": "shell",
            "key": "{#38;2;175;125;155}\u2502{#} {#38;2;248;190;160}\uf489 shell    {#38;2;175;125;155}\u2502{#}"
        },
        {
            "type": "uptime",
            "key": "{#38;2;175;125;155}\u2502{#} {#38;2;245;205;130}\udb80\udd50 uptime   {#38;2;175;125;155}\u2502{#}"
        },
        {
            "type": "packages",
            "key": "{#38;2;175;125;155}\u2502{#} {#38;2;170;215;150}\udb80\udfd6 pkgs     {#38;2;175;125;155}\u2502{#}"
        },
        {
            "type": "cpu",
            "key": "{#38;2;175;125;155}\u2502{#} {#38;2;150;215;195}\udb80\udf5b cpu      {#38;2;175;125;155}\u2502{#}"
        },
        {
            "type": "gpu",
            "key": "{#38;2;175;125;155}\u2502{#} {#38;2;200;170;235}\udb82\udcae gpu      {#38;2;175;125;155}\u2502{#}"
        },
        {
            "type": "memory",
            "key": "{#38;2;175;125;155}\u2502{#} {#38;2;244;167;185}\uefc5 memory   {#38;2;175;125;155}\u2502{#}"
        },
        {
            "type": "custom",
            "key": "{#38;2;175;125;155}\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524{#}"
        },
        {
            "type": "colors",
            "key": "{#38;2;175;125;155}\u2502{#} {#38;2;244;167;185}\udb80\udd1b colors   {#38;2;175;125;155}\u2502{#}",
            "symbol": "circle"
