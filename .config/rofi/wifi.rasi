/**
 * =============================================================================
 * ROFI AUTUMN KEMONO: SOFT PASTEL WI-FI DROPDOWN MENU
 * =============================================================================
 */

* {
    bg:             rgba(42, 26, 18, 0.96);
    bg-alt:         rgba(60, 38, 26, 0.90);
    bg-selected:    rgba(216, 107, 39, 0.92);
    fg:             #fcefe6;
    fg-dim:         #cfb29e;
    gold:           #e6a73c;
    border-col:     rgba(230, 167, 60, 0.75);
    border-dark:    rgba(80, 50, 35, 0.70);

    background-color: transparent;
    text-color:       var(fg);
    font:             "JetBrainsMono Nerd Font 10.5";
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    location:         northeast;
    anchor:           northeast;
    x-offset:         -14px;
    y-offset:         58px;
    width:            440px;
    background-color: var(bg);
    border:           2px;
    border-color:     var(border-col);
    border-radius:    18px;
    padding:          14px;
}

mainbox {
    spacing:          10px;
    children:         [ "inputbar", "message", "listview" ];
}

inputbar {
    background-color: var(bg-alt);
    border:           1px;
    border-color:     var(border-dark);
    border-radius:    12px;
    padding:          6px 12px;
    spacing:          8px;
    children:         [ "prompt", "entry" ];
}

prompt {
    text-color:       var(gold);
    font:             "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder:      "Поиск сети...";
    placeholder-color: var(fg-dim);
    text-color:       var(fg);
}

message {
    background-color: rgba(216, 107, 39, 0.15);
    border:           1px;
    border-color:     rgba(230, 167, 60, 0.35);
    border-radius:    10px;
    padding:          8px 12px;
}

textbox {
    text-color:       var(fg);
    font:             "JetBrainsMono Nerd Font 10";
}

listview {
    lines:            8;
    columns:          1;
    spacing:          5px;
    cycle:            true;
    scrollbar:        false;
}

element {
    padding:          7px 12px;
    border-radius:    10px;
    background-color: transparent;
    text-color:       var(fg);
    spacing:          8px;
}

element normal.normal {
    background-color: transparent;
    text-color:       var(fg);
}

element alternate.normal {
    background-color: rgba(255, 255, 255, 0.02);
    text-color:       var(fg);
}

element selected.normal {
    background-color: var(bg-selected);
    text-color:       #ffffff;
    border-radius:    10px;
}

element-text {
    text-color:       inherit;
    vertical-align:   0.5;
}

element-icon {
    size:             16px;
    vertical-align:   0.5;
}
