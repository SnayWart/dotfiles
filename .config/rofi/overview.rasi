* {
    bg:          #140f0cf5;
    bg-card:     #241a15fa;
    bg-selected: #d86b27ee;
    fg:          #fcefe6;
    fg-dim:      #cfb29e;
    gold:        #e6a73c;
    crimson:     #be382f;
    border-dark: #382820;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    location:         center;
    anchor:           center;
    fullscreen:       false;
    width:            960px;
    background-color: @bg;
    border:           2px;
    border-color:     @gold;
    border-radius:    24px;
    padding:          26px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  22px;
}

inputbar {
    enabled:          true;
    background-color: @bg-card;
    border:           1px;
    border-color:     @border-dark;
    border-radius:    14px;
    padding:          12px 18px;
    children:         [ prompt, entry ];
    spacing:          12px;
}

prompt {
    text-color: @gold;
    font:       "JetBrainsMono Nerd Font Bold 12";
}

entry {
    placeholder:       "Нажмите цифру 1..10 или выберите стрелками...";
    placeholder-color: @fg-dim;
    text-color:        @fg;
}

listview {
    columns:       5;
    lines:         2;
    cycle:         true;
    dynamic:       true;
    layout:        vertical;
    flow:          horizontal;
    spacing:       14px;
    fixed-columns: true;
}

element {
    orientation:      vertical;
    background-color: @bg-card;
    border-radius:    16px;
    padding:          18px 10px;
    spacing:          10px;
    border:           1px;
    border-color:     @border-dark;
}

element selected {
    background-color: @bg-selected;
    border:           1px;
    border-color:     @gold;
    text-color:       #ffffff;
}

element-icon {
    size:             48px;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    text-color:       inherit;
    font:             "JetBrainsMono Nerd Font Bold 10";
}
