/**
 * =============================================================================
 * ROFI WALLPAPER GALLERY: AUTUMN KEMONO / FURRY GRID
 * =============================================================================
 */

* {
    bg:             rgba(36, 24, 28, 0.96);
    bg-alt:         rgba(54, 34, 40, 0.90);
    bg-selected:    rgba(224, 108, 117, 0.92);
    fg:             #faedf2;
    fg-dim:         #cfb29e;
    sakura:         #f4a7b9;
    border-col:     rgba(244, 167, 185, 0.65);
    border-dark:    rgba(80, 50, 60, 0.70);

    background-color: transparent;
    text-color:       var(fg);
    font:             "JetBrainsMono Nerd Font 10.5";
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    location:         center;
    anchor:           center;
    width:            700px;
    background-color: var(bg);
    border:           2px;
    border-color:     var(border-col);
    border-radius:    20px;
    padding:          18px;
}

mainbox {
    spacing:          12px;
    children:         [ "inputbar", "message", "listview" ];
}

inputbar {
    background-color: var(bg-alt);
    border:           1px;
    border-color:     var(border-dark);
    border-radius:    12px;
    padding:          8px 14px;
    children:         [ "prompt", "entry" ];
}

prompt {
    text-color:       var(sakura);
    font:             "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder:      "Поиск обоев...";
    placeholder-color: var(fg-dim);
    text-color:       var(fg);
}

message {
    background-color: rgba(244, 167, 185, 0.12);
    border:           1px;
    border-color:     rgba(244, 167, 185, 0.35);
    border-radius:    10px;
    padding:          8px 12px;
}

textbox {
    text-color:       var(fg);
    font:             "JetBrainsMono Nerd Font 10";
}

listview {
    lines:            4;
    columns:          2;
    spacing:          8px;
    cycle:            true;
    scrollbar:        false;
}

element {
    padding:          8px 12px;
    border-radius:    12px;
    background-color: var(bg-alt);
    text-color:       var(fg);
    spacing:          12px;
    orientation:      horizontal;
}

element normal.normal {
    background-color: var(bg-alt);
    text-color:       var(fg);
}

element selected.normal {
    background-color: var(bg-selected);
    text-color:       #ffffff;
}

element-icon {
    size:             48px;
    border-radius:    8px;
    vertical-align:   0.5;
}

element-text {
    text-color:       inherit;
    vertical-align:   0.5;
}
